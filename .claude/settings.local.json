{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:gallery.codelessly.com)",
      "PowerShell(Get-ChildItem \"C:\\\\code\\\\MyWebsite\" -Recurse | Where-Object { -not $_.PSIsContainer } | Select-Object FullName, Length)",
      "PowerShell(Get-ChildItem -Path \"C:\\\\code\\\\MyWebsite\" -Recurse -File | ForEach-Object { \"$\\($_.FullName\\) \\($\\($_.Length\\) bytes\\)\" })"
    ]
  }
}
